# ---------------------------------------------------------------------------
# Variáveis de PRODUÇÃO da stack `estoque-ti` (docker-compose.producao.yml).
#
# No Dockhand: cadastre cada variável abaixo nas variáveis da stack (marque
# as senhas e segredos como secretas). Fora do Dockhand: copie para `.env`
# ao lado do compose. O arquivo real nunca é versionado (.gitignore) nem
# entra na imagem (.dockerignore).
#
# Valores abaixo são FICTÍCIOS. Ver docs/implantacao-vm.md.
# ---------------------------------------------------------------------------

# --- Endereço público ------------------------------------------------------
# Nome pelo qual os usuários acessam o sistema NO IIS (sem https:// e sem
# barra no fim). A aplicação usa https://${PUBLICO_HOST} como APP_BASE_URL, e
# o endereço de retorno a cadastrar no Entra ID fica:
#   https://${PUBLICO_HOST}/api/auth/retorno
PUBLICO_HOST=estoque.empresa.local

# Porta em que o nginx escuta nesta VM — é o destino que o IIS usa
# (ex.: http://172.18.0.12:8080).
NGINX_PORTA=8080

# --- PostgreSQL (VM 172.18.0.10) -------------------------------------------
# Contas criadas por docker/postgres/producao/criar-banco.sql.
# Caracteres especiais na senha precisam ir codificados na URL
# (ex.: @ -> %40, # -> %23, / -> %2F, : -> %3A).
#
# Aplicação — menor privilégio (somente DML).
DATABASE_URL=postgresql://estoque_app:troque-a-senha-app@172.18.0.10:5432/estoque_ti?schema=public
# Migrações — dona do schema; usada SÓ pelo job `migracoes`.
MIGRATION_DATABASE_URL=postgresql://estoque_migrator:troque-a-senha-migrator@172.18.0.10:5432/estoque_ti?schema=public

# --- Sessão ----------------------------------------------------------------
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 32
AUTH_SECRET=

# --- Microsoft Entra ID ----------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Primeiro administrador (e-mail com que a pessoa entra na Microsoft).
ADMIN_INICIAL_EMAIL=

# --- Operação --------------------------------------------------------------
EXPORT_MAX_ROWS=10000
# error | warn | info | debug
LOG_LEVEL=info

# Faixa da rede interna do Docker. Precisa NÃO colidir com a rede das VMs
# (172.18.0.0/x). Só mude se 10.250.0.0/24 já for usada na empresa.
DOCKER_SUBNET=10.250.0.0/24

# --- Stack -----------------------------------------------------------------
# Versão das imagens (tag gerada por docker/construir-imagens.sh). `latest` é
# a última gerada; use o hash de um commit anterior para voltar de versão.
ESTOQUE_VERSAO=latest
# Diretório do template do nginx na VM.
NGINX_TEMPLATES=/storage/opt-docker/estoque-ti-nginx/templates
