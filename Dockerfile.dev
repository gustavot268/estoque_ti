# Imagem de DESENVOLVIMENTO (usada por docker-compose.yml).
# Não use em produção: contém a árvore de desenvolvimento completa e roda
# `next dev`.
FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN apk add --no-cache openssl git \
  && corepack enable pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm exec prisma generate --config=prisma/prisma7.config.ts

# `node` já existe na imagem oficial e não é root.
USER node

EXPOSE 3000
CMD ["pnpm", "dev"]
