# Imagem de DESENVOLVIMENTO (usada por docker-compose.yml).
# Não use em produção: contém a árvore de desenvolvimento completa e roda
# `next dev`.
FROM node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN apk add --no-cache openssl git \
  && corepack enable pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm exec prisma generate --config=prisma/prisma7.config.ts

# `node` já existe na imagem oficial e não é root.
USER node

EXPOSE 3000
CMD ["pnpm", "dev"]
