# Imagem de DESENVOLVIMENTO (usada por docker-compose.yml).
# Não use em produção: contém a árvore de desenvolvimento completa e roda
# `next dev`.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN apk add --no-cache openssl git \
  && corepack enable pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm exec prisma generate --config=prisma/prisma7.config.ts

# `node` já existe na imagem oficial e não é root.
USER node

EXPOSE 3000
CMD ["pnpm", "dev"]
