# ---------------------------------------------------------------------------
# Exemplo de variáveis de ambiente — Estoque de TI
#
# TODOS os valores abaixo são FICTÍCIOS e servem apenas como modelo.
# Nunca coloque credenciais reais neste arquivo nem versione um `.env`.
# Em desenvolvimento no Codespaces, use "Codespaces Secrets".
# Em produção, use o cofre de segredos da infraestrutura.
#
# Copie para `.env` e ajuste:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Ambiente de execução --------------------------------------------------
# NODE_ENV é definido pelas ferramentas (next dev/build/start, vitest).
# APP_ENV é a variável de negócio: development | test | staging | production
APP_ENV=development
# Rótulo exposto ao navegador — apenas para o banner "fora de produção".
# Não coloque nada sensível aqui: variáveis NEXT_PUBLIC_* vão para o cliente.
NEXT_PUBLIC_APP_ENV=development
# URL pública da aplicação.
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL (desenvolvimento local via docker compose) -----------------
# Senhas locais fictícias, consumidas pelo docker-compose.yml para criar as
# roles. Troque por valores próprios; elas não valem nada fora da sua máquina.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=5432
ESTOQUE_DB_NAME=estoque_ti
ESTOQUE_TEST_DB_NAME=estoque_ti_test
ESTOQUE_SHADOW_DB_NAME=estoque_ti_shadow
ESTOQUE_MIGRATOR_PASSWORD=troque-esta-senha-local-migrator
ESTOQUE_APP_PASSWORD=troque-esta-senha-local-app

# Conta da APLICAÇÃO — menor privilégio (somente DML nas tabelas de dados).
DATABASE_URL=postgresql://estoque_app:troque-esta-senha-local-app@localhost:5432/estoque_ti?schema=public&connection_limit=10&pool_timeout=10

# Conta usada SOMENTE por migrações (dona do schema).
MIGRATION_DATABASE_URL=postgresql://estoque_migrator:troque-esta-senha-local-migrator@localhost:5432/estoque_ti?schema=public

# Banco ISOLADO de testes de integração. Nunca aponte para o banco do
# desenvolvedor nem para produção.
TEST_DATABASE_URL=postgresql://estoque_migrator:troque-esta-senha-local-migrator@localhost:5432/estoque_ti_test?schema=public

# Banco "sombra" usado SOMENTE por `prisma migrate dev` (desenvolvimento) para
# conferir o histórico de migrações. É apagado e recriado pelo Prisma a cada
# execução e nunca contém dados reais. Existe porque a role `estoque_migrator`
# é NOCREATEDB (menor privilégio) e não pode criar o banco sombra sozinha.
# Não é necessário em produção (`prisma migrate deploy` não usa banco sombra).
SHADOW_DATABASE_URL=postgresql://estoque_migrator:troque-esta-senha-local-migrator@localhost:5432/estoque_ti_shadow?schema=public

# --- Sessão --------------------------------------------------------------
# Obrigatório em produção. Gere com: openssl rand -base64 32
AUTH_SECRET=coloque-o-segredo-aqui

# --- Microsoft Entra ID ----------------------------------------------------
# Obrigatórias em produção. Os valores abaixo são placeholders inválidos de
# propósito: nenhum tenant, client ou grupo real é presumido aqui.
# Peça os valores corretos a quem administra o Entra ID da organização.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=coloque-o-segredo-aqui

# Mapeamento grupo do Entra ID -> perfil da aplicação.
# Sem grupos configurados, o acesso é NEGADO por padrão.
ENTRA_GROUP_ID_CONSULTA=00000000-0000-0000-0000-000000000000
ENTRA_GROUP_ID_OPERACAO=00000000-0000-0000-0000-000000000000
ENTRA_GROUP_ID_ADMINISTRACAO=00000000-0000-0000-0000-000000000000

# --- Modo de desenvolvimento sem credenciais do Entra ID -------------------
# Desativado por padrão. Só liga com o valor literal "true".
# Se APP_ENV ou NODE_ENV for production e isto estiver "true", a aplicação
# FALHA na inicialização, de propósito.
DEV_AUTH_ENABLED=false

# --- Operação --------------------------------------------------------------
# Limite de linhas por exportação para Excel.
EXPORT_MAX_ROWS=10000
# error | warn | info | debug
LOG_LEVEL=info
